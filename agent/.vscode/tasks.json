{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validate prerequisites",
      "type": "aitk",
      "command": "debug-check-prerequisites",
      "args": {
        "portOccupancy": [
          5679,
          8088
        ]
      }
    },
    {
      "label": "Run Attestation Agent HTTP Server",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m debugpy --listen 127.0.0.1:5679 agent.py --server --port 8088",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/agent"
      },
      "dependsOn": [
        "Validate prerequisites"
      ],
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 0,
            "location": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application startup complete|[Rr]unning on|Started server process|Server running"
        }
      }
    },
    {
      "label": "Run Attestation Agent CLI",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m debugpy --listen 127.0.0.1:5679 agent.py --cli",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/agent"
      },
      "dependsOn": [
        "Validate prerequisites"
      ],
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 0,
            "location": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Type 'exit' to quit"
        }
      }
    },
    {
      "label": "Terminate All Tasks",
      "command": "echo ${input:terminate}",
      "type": "shell",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}
